{
  "name": "ai-hub",
  "version": "1.0.0",
  "description": "Quorum – Claude Code, GPT Codex, Antigravity, OpenCode und Ollama an einem Tisch, mit Multi-Agent-Modus.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:chat-host && vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.cli.config.ts && npm run build:chat-host",
    "typecheck": "tsc --noEmit",
    "test:providers": "node --experimental-strip-types scripts/check-provider-management.mjs",
    "test:chat-controls": "node --experimental-strip-types scripts/check-chat-controls.mjs",
    "test:dev-releases": "node scripts/check-dev-release-cleanup.mjs",
    "test:chat-modes": "node --experimental-strip-types scripts/check-chat-modes.mjs",
    "test:3d": "node --experimental-strip-types scripts/check-3d.mjs",
    "start": "electron . --no-sandbox",
    "dist": "npm run build && electron-builder --publish never",
    "update:linux": "bash scripts/update-linux.sh",
    "icons": "node scripts/make-icons.ts",
    "dist:linux": "node scripts/check-chat-platform.mjs linux x64 && npm run icons && npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:win": "node scripts/check-chat-platform.mjs win32 x64 && npm run icons && npm run build && electron-builder --win zip --x64 --publish never",
    "dist:mac": "node scripts/check-chat-platform.mjs darwin arm64 && npm run icons && npm run build && electron-builder --mac zip --arm64 --publish never",
    "dist:all": "npm run dist:linux && npm run dist:win && npm run dist:mac",
    "release": "node scripts/release.ts",
    "release:dev": "node scripts/release.ts dev",
    "release:beta": "node scripts/release.ts beta",
    "release:stable": "node scripts/release.ts release",
    "build:cli": "vite build -c vite.cli.config.ts",
    "test:cli": "node --experimental-strip-types scripts/check-cli.mjs",
    "test:plan-core": "node --experimental-strip-types scripts/check-plan-core.mjs",
    "test:plan-cli": "python3 scripts/check-plan-cli.py",
    "test:lsp-core": "node --experimental-strip-types scripts/check-lsp-core.mjs",
    "test:lsp-servers": "python3 scripts/check-lsp-servers.py",
    "test:ide-ui": "electron --no-sandbox scripts/check-ide-electron.cjs",
    "test:workspace-search": "node --experimental-strip-types scripts/check-workspace-search.mjs",
    "build:chat-host": "cargo build --release --locked --manifest-path native/chat-host/Cargo.toml && node scripts/build-chat-host.mjs",
    "build:worker": "vite build -c vite.worker.config.ts",
    "test:chat-host": "python3 scripts/check-chat-host.py",
    "test:chat-recovery": "node --experimental-strip-types scripts/check-chat-host-recovery.mjs",
    "test:chat-manager": "node --experimental-strip-types scripts/check-chat-host-manager.mjs",
    "test:chat-provider-worker": "python3 scripts/check-chat-provider-worker.py",
    "test:chat-lifecycle": "node scripts/check-chat-lifecycle.mjs",
    "test:chat-persistence": "node --experimental-strip-types scripts/check-chat-persistence.mjs",
    "test:chat-runtime": "node --experimental-strip-types scripts/check-chat-runtime.mjs",
    "test:input-history": "node --experimental-strip-types scripts/check-input-history.mjs",
    "test:git-launch": "node --experimental-strip-types scripts/check-git-launch.mjs",
    "test:agent-overview": "node --experimental-strip-types scripts/check-agent-overview.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify/react": "^6.0.0",
    "@iconify/types": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "pyright": "^1.1.414",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-language-server": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^0.29.0",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "dev.quorum.app",
    "productName": "Quorum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-cli/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Quorum <admin@bluenet-hosting.com>",
      "executableName": "quorum",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py",
          "requirements.txt"
        ]
      },
      {
        "from": "node_modules/typescript-language-server",
        "to": "language-servers/node_modules/typescript-language-server",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "node_modules/typescript",
        "to": "language-servers/node_modules/typescript",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "node_modules/pyright",
        "to": "language-servers/node_modules/pyright",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "native/bin",
        "to": "chat-host",
        "filter": [
          "quorum-chat-host*"
        ]
      }
    ]
  },
  "author": {
    "name": "Quorum",
    "email": "admin@bluenet-hosting.com"
  },
  "homepage": "https://localhost",
  "desktopName": "quorum.desktop",
  "bin": {
    "quorum": "bin/quorum.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
